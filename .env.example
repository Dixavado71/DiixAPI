# Node.js Environment
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis
REDIS_URL=${{Redis.REDIS_URL}}

# Evolution API
EVOLUTION_API_URL=https://evolution-api-production-8490.up.railway.app
EVOLUTION_API_KEY=NOVO_SEGREDO_DA_EVOLUTION
EVOLUTION_WEBHOOK_SECRET=OUTRO_SEGREDO

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
